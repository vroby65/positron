#!/usr/bin/env python3
# Positron: a mini "Electron-like" using pywebview
# - Serves ./www on http://127.0.0.1:7000
# - Title = POSITRON_TITLE (env) or executable basename
# - Persistent storage (localStorage/cookie) per bundle
# - Window options: --size, --min-size, --pos, --fullscreen, --fixed, --gui
# - Supports both static HTML and React/Vite projects

from __future__ import annotations

import os
import queue
import re
import signal
import shutil
import sys
import time
import socket
import threading
import argparse
import subprocess
from http.server import ThreadingHTTPServer, SimpleHTTPRequestHandler
from pathlib import Path
import webview

HOST = "127.0.0.1"
PORT = 7000
REACT_PORTS = (5173, 3000, 8080)
LOCAL_URL = re.compile(r"https?://(?:127\.0\.0\.1|localhost|\[::1\]):(\d+)")

# ----------------- utils -----------------
def parse_size(s):
    try:
        w, h = s.lower().split("x")
        w, h = int(w), int(h)
        if w < 100 or h < 100:
            raise ValueError
        return (w, h)
    except Exception:
        raise argparse.ArgumentTypeError("Expected format: WIDTHxHEIGHT (e.g. 1200x800)")

def parse_pos(s):
    try:
        x, y = s.split(",")
        return (int(x), int(y))
    except Exception:
        raise argparse.ArgumentTypeError("Expected format: X,Y (e.g. 100,50)")

def wait_for_server(host, port, timeout=10.0):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            with socket.create_connection((host, port), timeout=0.5):
                return True
        except OSError:
            time.sleep(0.25)
    return False

def server_is_reachable(host, port):
    try:
        with socket.create_connection((host, port), timeout=0.2):
            return True
    except OSError:
        return False

def start_http_server(root, host, port, no_cache=False):
    class Handler(SimpleHTTPRequestHandler):
        def __init__(self, *args, **kwargs):
            super().__init__(*args, directory=str(root), **kwargs)
        def log_message(self, fmt, *args):
            sys.stdout.write(f"[http] {self.address_string()} - " + (fmt % args) + "\n")
        def end_headers(self):
            if no_cache:
                self.send_header("Cache-Control", "no-store, no-cache, must-revalidate, max-age=0")
                self.send_header("Pragma", "no-cache")
                self.send_header("Expires", "0")
            super().end_headers()

    httpd = ThreadingHTTPServer((host, port), Handler)
    httpd.daemon_threads = True
    threading.Thread(target=httpd.serve_forever, name="positron-http", daemon=True).start()
    return httpd

def ensure_default_index(www_dir):
    index = www_dir / "index.html"
    if not index.exists():
        index.write_text(
            """<!doctype html><meta charset="utf-8"><title>Positron</title>
<style>:root{color-scheme:light dark}body{font:16px/1.5 system-ui;margin:2rem;max-width:60ch}</style>
<h1>Positron is alive ✨</h1>
<p>This page is served from <code>./www</code>. Replace <code>www/index.html</code> with your own app.</p>
""",
            encoding="utf-8",
        )

_PERSISTENCE_SETUP_DONE = False
_LAST_STORAGE_DIR: Path

def _enable_webkitgtk_settings(native_webview):
    changed = False
    try:
        settings = native_webview.get_settings()
        for prop in ("enable-indexed-database", "enable-local-storage"):
            try:
                if not settings.get_property(prop):
                    settings.set_property(prop, True)
                    changed = True
                    print(f"[positron] WebKitGTK setting '{prop}' -> True")
            except Exception:
                pass
        try:
            settings.set_property("enable-developer-extras", True)
        except Exception:
            pass
    except Exception as e:
        print(f"[positron] WebKitGTK settings tweak skipped: {e}")
    return changed

def _pin_qt_profile(storage_dir, window):
    try:
        native = getattr(window, "native", None)
        if not native:
            return
        page = native.webview.page()
        profile = page.profile() if callable(getattr(page, "profile", None)) else page.profile
        q_data = str(storage_dir / "qt-profile")
        q_cache = str(storage_dir / "qt-cache")
        profile.setPersistentStoragePath(q_data)
        profile.setCachePath(q_cache)
        try:
            from PyQt5.QtWebEngineWidgets import QWebEngineProfile as QEP
            profile.setPersistentCookiesPolicy(QEP.ForcePersistentCookies)
        except Exception:
            try:
                from PySide6.QtWebEngineCore import QWebEngineProfile as QEP
                profile.setPersistentCookiesPolicy(QEP.ForcePersistentCookies)
            except Exception:
                pass
        print(f"[positron] Qt profile pinned -> data={q_data} cache={q_cache}")
    except Exception as e:
        print(f"[positron] Qt profile pin skipped: {e}")

def _infer_backend(window):
    try:
        native = getattr(window, "native", None)
        if not native:
            return ""
        native_webview = getattr(native, "webview", None)
        if not native_webview:
            return ""
        if hasattr(native_webview, "get_settings"):
            return "gtk"
        if hasattr(native_webview, "page"):
            native_webview.page()
            return "qt"
    except Exception:
        pass
    return ""

def _setup_persistence(renderer_hint, window, storage_dir):
    global _PERSISTENCE_SETUP_DONE
    if _PERSISTENCE_SETUP_DONE:
        return False

    renderer = (renderer_hint or "").lower()
    active = getattr(webview, "guilib", "") or ""
    if active:
        renderer = getattr(active, "renderer", str(active)).lower()
    if not renderer:
        renderer = _infer_backend(window)

    print(f"[positron] persistence setup for backend='{renderer}' storage_path={storage_dir}")
    try:
        native = getattr(window, "native", None)
        if not native:
            print("[positron] native view not available yet")
            return False
        _PERSISTENCE_SETUP_DONE = True
        if "qt" in renderer:
            _pin_qt_profile(storage_dir, window)
        elif "gtk" in renderer or "webkit" in renderer:
            if _enable_webkitgtk_settings(native.webview):
                native.webview.reload()
                print("[positron] WebKitGTK settings applied -> reload")
                return True
        else:
            print("[positron] other backend -> rely on storage_path")
    except Exception as e:
        print(f"[positron] persistence setup failed: {e}")
    return False

def on_loaded(window):
    try:
        if _setup_persistence(os.environ.get("PYWEBVIEW_GUI"), window, _LAST_STORAGE_DIR):
            return
    except Exception as e:
        print(f"[positron] persistence (late) error: {e}")
    try:
        res = window.evaluate_js("(() => { localStorage.setItem('__probe','ok'); return 6*7; })()")
        print(f"[positron] JS OK → {res}")
    except Exception as e:
        print(f"[positron] JS evaluate_js FAILED: {e}")

TEMP_EXTS = (".crdownload", ".part", ".partial", ".download", ".tmp")

def detect_download_dir():
    if sys.platform.startswith("linux"):
        try:
            path = subprocess.check_output(
                ["xdg-user-dir", "DOWNLOAD"],
                text=True,
                stderr=subprocess.DEVNULL,
            ).strip()
            if path and Path(path).exists():
                return Path(path)
        except Exception:
            pass
        return Path.home() / "Downloads"
    if sys.platform.startswith("win"):
        return Path(os.environ.get("USERPROFILE", str(Path.home()))) / "Downloads"
    return Path.home() / "Downloads"

def is_temp_file(path):
    name = path.name.lower()
    return any(name.endswith(ext) for ext in TEMP_EXTS)

def choose_save_as(window, default_name, start_dir):
    try:
        result = window.create_file_dialog(
            webview.SAVE_DIALOG,
            directory=str(start_dir),
            save_filename=default_name,
        )
        if not result:
            return None
        if isinstance(result, (list, tuple)):
            return Path(result[0])
        return Path(result)
    except Exception as e:
        print(f"[positron] Save-as dialog error: {e}")
        return None

class Api:
    def save_file(self, filename, content):
        path = choose_save_as(webview.windows[0], default_name=filename, start_dir=Path.home())
        if not path:
            return "Cancelled"
        path.write_text(str(content), encoding="utf-8")
        print(f"[positron] Saved file -> {path}")
        return f"Saved to {path}"

def list_finished(dirpath):
    try:
        return {
            entry.name
            for entry in os.scandir(dirpath)
            if entry.is_file(follow_symlinks=False) and not is_temp_file(Path(entry.name))
        }
    except FileNotFoundError:
        return set()

def wait_file_stable(path, stable_secs=0.8, timeout=300.0):
    start = time.monotonic()
    try:
        last_size = path.stat().st_size
    except FileNotFoundError:
        return True
    last_change = time.monotonic()
    while time.monotonic() - start < timeout:
        time.sleep(0.2)
        try:
            current_size = path.stat().st_size
        except FileNotFoundError:
            return True
        if current_size != last_size:
            last_size = current_size
            last_change = time.monotonic()
        elif time.monotonic() - last_change >= stable_secs:
            return True
    return False

def unique_destination(path):
    if not path.exists():
        return path
    index = 1
    while True:
        candidate = path.parent / f"{path.stem} ({index}){path.suffix}"
        if not candidate.exists():
            return candidate
        index += 1

def download_watcher_polling(stop_event, window, watch_dir):
    seen = list_finished(watch_dir)
    print(f"[positron] polling watching {watch_dir}")
    delay = 0.5

    def confirm_overwrite(path):
        try:
            message = f"File '{path.name}' already exists.\nDo you want to overwrite it?"
            return bool(window.create_confirmation_dialog("Overwrite file?", message))
        except Exception as e:
            print(f"[positron] overwrite confirm dialog error: {e}")
            return False

    while not stop_event.is_set():
        try:
            current = list_finished(watch_dir)
            new_files = current - seen
            if new_files:
                delay = 0.5
                for filename in sorted(new_files):
                    source = watch_dir / filename
                    wait_file_stable(source)
                    destination = choose_save_as(window, filename, watch_dir)
                    if not destination:
                        try:
                            source.unlink()
                            print(f"[positron] User cancelled -> deleted {source}")
                        except Exception as e:
                            print(f"[positron] Cannot delete cancelled file {source}: {e}")
                        continue
                    if destination.exists() and destination.is_dir():
                        destination /= filename
                    if destination.exists():
                        if confirm_overwrite(destination):
                            try:
                                destination.unlink()
                                print(f"[positron] Overwriting {destination}")
                            except Exception as e:
                                print(f"[positron] Cannot remove existing {destination}: {e}")
                                destination = unique_destination(destination)
                        else:
                            destination = unique_destination(destination)
                    try:
                        destination.parent.mkdir(parents=True, exist_ok=True)
                        shutil.move(str(source), str(destination))
                        print(f"[positron] Moved {filename} -> {destination}")
                    except Exception as e:
                        print(f"[positron] Move failed: {e}")
                seen = current
            else:
                delay = min(4.0, delay * 1.3)
            stop_event.wait(delay)
        except Exception as e:
            print(f"[positron] polling watcher error: {e}")
            stop_event.wait(1.0)

def stop_process(proc):
    if proc.poll() is None:
        if os.name == "nt":
            subprocess.run(
                ["taskkill", "/PID", str(proc.pid), "/T", "/F"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                check=False,
            )
        else:
            os.killpg(proc.pid, signal.SIGTERM)

        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            if os.name == "nt":
                proc.kill()
            else:
                os.killpg(proc.pid, signal.SIGKILL)
            proc.wait()

    if proc.stdout:
        proc.stdout.close()

def start_react_server(base_dir, timeout=15):
    npm = "npm.cmd" if os.name == "nt" else "npm"
    if not (base_dir / "node_modules").exists():
        print("[positron] Missing node_modules: running npm install…")
        subprocess.run([npm, "install"], cwd=base_dir, check=True)

    occupied_ports = {port for port in REACT_PORTS if server_is_reachable(HOST, port)}
    found_ports = queue.Queue()
    proc = subprocess.Popen(
        [npm, "run", "dev"],
        cwd=base_dir,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        bufsize=1,
        start_new_session=os.name != "nt",
        creationflags=subprocess.CREATE_NEW_PROCESS_GROUP if os.name == "nt" else 0,
    )

    def forward_output():
        for line in proc.stdout:
            print(line, end="")
            match = LOCAL_URL.search(line)
            if match:
                found_ports.put(int(match.group(1)))

    threading.Thread(target=forward_output, name="positron-react-output", daemon=True).start()
    candidate_ports = set(REACT_PORTS) - occupied_ports
    deadline = time.monotonic() + timeout

    while time.monotonic() < deadline:
        while not found_ports.empty():
            candidate_ports.add(found_ports.get_nowait())

        for port in candidate_ports:
            if server_is_reachable(HOST, port):
                return proc, f"http://{HOST}:{port}"

        if proc.poll() is not None:
            stop_process(proc)
            raise RuntimeError(f"React dev server exited with code {proc.returncode}")
        time.sleep(0.1)

    stop_process(proc)
    raise RuntimeError(f"React dev server not reachable after {timeout}s")

# ----------------- main -----------------
def main():
    global _LAST_STORAGE_DIR

    ap = argparse.ArgumentParser(description="Positron runner")
    ap.add_argument("--gui", help="GUI backend (gtk/qt/edgechromium/mshtml/cocoa)")
    ap.add_argument("--debug", action="store_true", help="Enable pywebview debug mode")
    ap.add_argument("--size", type=parse_size, help="Window size: WIDTHxHEIGHT (e.g. 1200x800)")
    ap.add_argument("--min-size", dest="min_size", type=parse_size, help="Minimum window size: WIDTHxHEIGHT")
    ap.add_argument("--pos", type=parse_pos, help="Initial window position: X,Y (e.g. 100,50)")
    ap.add_argument("--fullscreen", action="store_true", help="Start in fullscreen mode")
    ap.add_argument("--fixed", action="store_true", help="Disable window resizing")
    ap.add_argument("--react", action="store_true", help="Force React/Vite mode (npm dev server)")
    ap.add_argument("--watch-dir", help="Directory to watch for completed downloads")
    ap.add_argument("--profile-dir", help="Override storage root directory")
    args = ap.parse_args()

    base_dir = Path(__file__).resolve().parent
    www_dir = base_dir / "www"
    package_json = base_dir / "package.json"

    use_react = args.react or package_json.exists()

    # ------------------- REACT MODE -------------------
    if use_react:
        print("[positron] Detected React project — starting dev server...")
        try:
            proc, url = start_react_server(base_dir)
        except (OSError, subprocess.CalledProcessError, RuntimeError) as e:
            print(f"[positron] Error: {e}")
            sys.exit(1)
        print(f"[positron] Connected to {url}")

    # ------------------- STATIC MODE -------------------
    else:
        www_dir.mkdir(exist_ok=True)
        ensure_default_index(www_dir)

        try:
            httpd = start_http_server(www_dir, HOST, PORT, no_cache=True)
        except OSError as e:
            print(f"Error: cannot start HTTP server on {HOST}:{PORT} — {e}")
            sys.exit(1)
        if not wait_for_server(HOST, PORT, timeout=5.0):
            print("Error: HTTP server not reachable after startup.")
            sys.exit(1)
        index_size = (www_dir / "index.html").stat().st_size
        url = f"http://{HOST}:{PORT}/index.html?{index_size}"

    # ------------------- WINDOW -------------------
    bundle_title = os.environ.get("POSITRON_TITLE") or Path(sys.argv[0]).stem or "Positron"
    env_profile = os.environ.get("POSITRON_PROFILE_DIR")
    if args.profile_dir:
        storage_dir = Path(args.profile_dir).expanduser()
    elif env_profile:
        storage_dir = Path(env_profile).expanduser()
    else:
        storage_dir = Path.home() / ".positron" / bundle_title
    storage_dir.mkdir(parents=True, exist_ok=True)
    _LAST_STORAGE_DIR = storage_dir

    win_kwargs = {}
    if args.size: win_kwargs["width"], win_kwargs["height"] = args.size
    if args.min_size: win_kwargs["min_size"] = args.min_size
    if args.pos: win_kwargs["x"], win_kwargs["y"] = args.pos
    if args.fullscreen: win_kwargs["fullscreen"] = True
    if args.fixed: win_kwargs["resizable"] = False

    def pick_default_gui():
        if sys.platform.startswith("linux"):
            return "gtk"
        if sys.platform == "darwin":
            return "cocoa"
        if sys.platform.startswith("win"):
            return "edgechromium"
        return None

    selected_gui = args.gui or pick_default_gui()
    print(f"[positron] backend target: {selected_gui or 'auto'} | storage_path={storage_dir}")
    window = webview.create_window(bundle_title, url, js_api=Api(), **win_kwargs)

    try:
        _setup_persistence(selected_gui, window, storage_dir)
    except Exception as e:
        print(f"[positron] early persistence setup skipped: {e}")

    watch_dir = Path(args.watch_dir).expanduser() if args.watch_dir else detect_download_dir()
    stop_event = threading.Event()
    threading.Thread(
        target=download_watcher_polling,
        args=(stop_event, window, watch_dir),
        name="positron-download-watcher",
        daemon=True,
    ).start()

    try:
        webview.start(
            on_loaded,
            window,
            debug=args.debug or os.environ.get("POSITRON_DEBUG", "").lower() in ("1", "true", "yes"),
            private_mode=False,
            storage_path=str(storage_dir),
            gui=selected_gui,
        )
    finally:
        stop_event.set()
        if use_react:
            stop_process(proc)
        else:
            httpd.shutdown()
            httpd.server_close()

if __name__ == "__main__":
    main()
